# Copiez ce fichier vers .env.local puis renseignez vos propres valeurs.
# .env.local est ignoré par git : ne mettez jamais de vraie valeur dans ce fichier d'exemple.

# Connexion PostgreSQL (lib/database-postgres.ts et scripts/pg-config.cjs)
PGHOST=localhost
PGPORT=5432
PGDATABASE=portfolio
PGUSER=
PGPASSWORD=

# Secret de signature des tokens JWT de l'administration (longue chaîne aléatoire), par exemple :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Mot de passe du compte "admin", utilisé uniquement à sa création (initialisation de la base)
ADMIN_PASSWORD=
